# Production Firebase Configuration (bhuiya-property-manager)
VITE_FIREBASE_API_KEY=your_production_api_key
VITE_FIREBASE_AUTH_DOMAIN=bhuiya-property-manager.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bhuiya-property-manager
VITE_FIREBASE_STORAGE_BUCKET=bhuiya-property-manager.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
VITE_FIREBASE_APP_ID=your_production_app_id

# Edge API / Backend Configuration
VITE_API_BASE_URL=

# Safety Gate (Must be true for initial read-only verification)
VITE_DISABLE_FINANCIAL_WRITES=true
